{
  // Shared compiler settings. Every package extends this file, so strictness cannot be
  // quietly weakened in one corner of the monorepo without the change being visible here.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],

    // Non-negotiable per docs/PHASE1_BRIEF.md §5 and CLAUDE.md.
    "strict": true,

    // Cheap extra safety with no authoring cost.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // ENABLED at the end of Task B, as decided by Shantanu on 4 Aug 2026.
    //
    // This flag types `ORGANS[key]` as possibly-undefined, which catches a real class of bug in
    // a rules engine built on Record lookups. It was deliberately kept OFF for the port itself:
    // flipping it mid-port would have meant hundreds of pre-existing lookups failing at once,
    // and the path of least resistance under that pressure is to scatter `!` until it compiles —
    // which silences the compiler without handling anything.
    //
    // WHAT IT ACTUALLY FOUND, turned on against the finished port: ten lookups, of which
    //   - seven were provably present, and the fix was to stop discarding the guard's own
    //     result and re-indexing (read once, reuse);
    //   - two were the NaN-accumulating stats counters, which are a KNOWN preserved bug
    //     (docs/FINDINGS.md #3) and are now written as an explicit NaN rather than an accident;
    //   - one was a bug nobody knew about: returnAP does not validate its pid, so an unknown
    //     pid returning 0 AP writes NaN into the budget map (docs/FINDINGS.md #20).
    //
    // `!` is NOT an acceptable way to satisfy this flag, and none was used — enforced by
    // @typescript-eslint/no-non-null-assertion, which is an error in packages/engine.
    // If a lookup can miss, handle the miss.
    "noUncheckedIndexedAccess": true,

    // Module hygiene. isolatedModules and verbatimModuleSyntax keep every file
    // independently transpilable, which is what Vite and esbuild assume.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  }
}
