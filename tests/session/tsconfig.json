{
  // Same reasoning as tests/equivalence/tsconfig.json: this is test infrastructure, not shipped
  // code, and it reuses the equivalence rig's modules — which read the legacy engine off disk and
  // swap the global Math.random. Node types are allowed here for that reason and no other;
  // nothing in packages/ gains them.
  //
  // "jsx": the offered ⊆ accepted harness (offered.test.ts) imports packages/ui's pure
  // `offeredActions` through the package root, whose index also re-exports .tsx components, so
  // the program must know how to read them — it never renders one.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts"]
}
