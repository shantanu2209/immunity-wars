{
  // What runs on Node: the recorder, which drives the real engine, and the Vite configuration.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "blender/*.ts", "src/recording-types.ts"]
}
