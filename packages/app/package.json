{
  "name": "@immunity-wars/app",
  "version": "0.0.0",
  "private": true,
  "description": "Vite application shell.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build": "tsc -p tsconfig.json",
    "dev": "vite"
  },
  "comment:dependencies": "session and content, and deliberately NOT engine. ui-app-no-engine forbids the engine; ui-app-no-unresolvable makes an unresolved import red too, so a permitted dependency that is not declared is also red. Declaring these is what makes the permission true rather than written down.",
  "dependencies": {
    "@immunity-wars/session": "workspace:*",
    "@immunity-wars/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@immunity-wars/content": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0"
  }
}
