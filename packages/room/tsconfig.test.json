{
  // Tests are typechecked separately, for the reason packages/session states: vitest's types
  // pull in @types/node, whose ambient globals would otherwise be visible to the source program
  // and defeat the "types": [] purity above.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
