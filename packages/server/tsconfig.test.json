{
  // Tests are typechecked, but separately from production code.
  //
  // A test file imports vitest, whose type definitions pull in @types/node. Ambient
  // globals from that are visible to EVERY file in the same program — so with tests and
  // source in one tsconfig, `process` and `Buffer` silently become available inside the
  // engine, defeating the "types": [] purity guarantee. Splitting the programs keeps the
  // guarantee on source while still typechecking the tests.
  //
  // DOM IN THE TEST PROGRAM ONLY (P3.4). relay.test.ts plays RelaySession, which is client code
  // written for a browser, against this relay; typechecking it here typechecks packages/session,
  // whose IndexedDB storage needs DOM types. The relay's own program (tsconfig.json) stays Node
  // only, so nothing the relay ships can reach for a browser global.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
